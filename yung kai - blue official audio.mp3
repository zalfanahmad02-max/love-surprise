ID3
</script>

<audio id="ID3" loop>
  <source src="ID3" type="audio/mpeg">
</audio>

<button id="playBtn">▶ PLAY MUSIC ❤️</button>

<script>

const musik = document.getElementById("ID3");
const playBtn = document.getElementById("playBtn");
const startBtn = document.getElementById("startBtn");
const intro = document.getElementById("intro");

// START BUTTON
startBtn.addEventListener("click", async () => {

    intro.style.display = "none";

    ID3.load();
    ID3.volume = 0.3;

    try {
        await ID3.play();
        console.log("ID3 jalan");
    } catch (error) {
        console.log(error);
    }
});

// PLAY BUTTON
playBtn.addEventListener("click", async () => {

    ID3.volume = 0.3;

    try {
        if (ID3.paused) {
            await ID3.play();
        } else {
            ID3.pause();
        }
    } catch (error) {
        console.log(error);
    }
});
</script>
